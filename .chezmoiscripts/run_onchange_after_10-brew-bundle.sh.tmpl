{{- if eq .chezmoi.os "darwin" -}}
{{- $groups := list "common" -}}
{{- if eq .profile "personal" }}{{ $groups = append $groups "personal" }}{{ end -}}
{{- range .clouds }}{{ $groups = append $groups . }}{{ end -}}
#!/bin/sh
# Install Homebrew packages for: {{ $groups | join ", " }}.
# Re-runs whenever .chezmoidata/packages.yaml or the local Brewfile changes.
{{- $local := joinPath .chezmoi.homeDir ".config/chezmoi/Brewfile.local" }}
# Brewfile.local hash: {{ if stat $local }}{{ include $local | sha256sum }}{{ else }}none{{ end }}
set -eu
eval "$({{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/brew shellenv)"

brew bundle --no-upgrade --file=- <<'BREWFILE'
{{ range $g := $groups }}{{ range (get (index $.packages $g) "taps" | default (list)) -}}
tap {{ . | quote }}
{{ end }}{{ end -}}
{{ range $g := $groups }}{{ range (get (index $.packages $g) "brews" | default (list)) -}}
brew {{ . | quote }}
{{ end }}{{ end -}}
{{ range $g := $groups }}{{ range (get (index $.packages $g) "casks" | default (list)) -}}
cask {{ . | quote }}
{{ end }}{{ end -}}
{{ range $g := $groups }}{{ range (get (index $.packages $g) "vscode" | default (list)) -}}
vscode {{ . | quote }}
{{ end }}{{ end -}}
{{ range $g := $groups }}{{ range (get (index $.packages $g) "mas" | default (list)) -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end }}{{ end -}}
BREWFILE

if [ -f "${HOME}/.config/chezmoi/Brewfile.local" ]; then
  brew bundle --no-upgrade --file="${HOME}/.config/chezmoi/Brewfile.local"
fi
{{ end -}}
