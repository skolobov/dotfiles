# Homebrew: Apple Silicon, Intel or Linux; skipped quietly until it's installed
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x "${brew}" ]] && eval "$("${brew}" shellenv zsh)" && break
done
unset brew

# User tools first; mise shims let non-interactive shells find mise tools
typeset -U path
path=(
  ~/.local/bin(N-/)
  ~/.local/share/mise/shims(N-/)
  $path
)

# Added by OrbStack: command-line tools and integration
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
