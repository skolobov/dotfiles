[user]
	name  = Sergei Kolobov
	email = {{ .email | quote }}

[core]
  excludesfile = ~/.config/git/ignore
  whitespace = -indent-with-non-tab,trailing-space,cr-at-eol
  quotepath = false
  autocrlf = input
  pager = delta

[init]
  defaultBranch = main
  templatedir = ~/.config/git/templates

[pull]
	rebase = true

[push]
  default = current

[merge]
  summary = true
  conflictstyle = diff3

[rebase]
  updateRefs = true

[alias]
  br = branch
  co = checkout
  ci = commit
  glog = log -E -i --grep
  sla = log --oneline --decorate --graph --all
  st = status
  unstage = reset HEAD --
  uncommit = reset --soft HEAD^

[color]
  ui = auto

[diff]
  colorMoved = default
  indentHeuristic = true
  compactionHeuristic = true

[delta]
  navigate = true    # use n and N to move between diff sections
  light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
  side-by-side = true

[interactive]
    diffFilter = delta --color-only

[apply]
  whitespace = nowarn

[gpg]
	program = {{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/gpg
{{- /* Per-context identities; the include files come from run_onchange_after_20-git-contexts */}}
{{- range .workContexts }}

[includeIf "gitdir:{{ .dir | trimSuffix "/" }}/"]
	path = ~/.config/git/{{ .name }}.config
{{- end }}
