# Oh My Zsh (https://ohmyz.sh); the prompt comes from Starship, so no theme
export ZSH="${HOME}/.oh-my-zsh"

# Disable warning about "insecure" directories in ${HOMEBREW_PREFIX}/share/zsh
ZSH_DISABLE_COMPFIX=true

zstyle ':omz:update' mode disabled  # chezmoi updates it via .chezmoiexternal.toml

# Don't count untracked files as dirty; much faster in large repositories
DISABLE_UNTRACKED_FILES_DIRTY="true"

HIST_STAMPS="dd.mm.yyyy"

# Keep a long history, in memory and on disk (Oh My Zsh already sets
# SHARE_HISTORY and HIST_IGNORE_SPACE)
HISTSIZE=1500000
SAVEHIST=${HISTSIZE}
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

# Catppuccin colors for zsh-syntax-highlighting
ZSH_THEMES_DIR="${HOME}/.config/zsh/themes"
[[ -f "${ZSH_THEMES_DIR}/catppuccin_mocha-zsh-syntax-highlighting.zsh" ]] &&
  source "${ZSH_THEMES_DIR}/catppuccin_mocha-zsh-syntax-highlighting.zsh"

# ssh-agent: reuse the macOS agent and load passphrases stored in the Keychain
# (store one once with: /usr/bin/ssh-add --apple-use-keychain ~/.ssh/<key>)
zstyle :omz:plugins:ssh-agent honor-existing yes
zstyle :omz:plugins:ssh-agent ssh-add-args --apple-load-keychain
zstyle :omz:plugins:ssh-agent quiet yes

# Add wisely, as too many plugins slow down shell startup.
plugins=(
  alias-finder
  aliases
  aws
  brew
  colored-man-pages
  docker
  gh
  git
  gitignore
  history-substring-search
  httpie
  isodate
  kubectl
  per-directory-history
  ssh-agent
  terraform
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "${ZSH}/oh-my-zsh.sh"

export LANG=en_US.UTF-8
export LC_ALL=${LANG}

# Preferred editor for local and remote sessions
if (( $+commands[nvim] )); then
  export EDITOR="nvim"
  alias vim=${EDITOR}
else
  export EDITOR="vim"
fi
export VISUAL=${EDITOR}

# Personal aliases, overriding those from Oh My Zsh (its gl is git pull)
alias c="clear"
alias g="git"
alias gd="git diff"
alias gl="git log"
alias gs="git status"
alias h="history"
alias ls="lsd"
alias tg="terragrunt"
alias mdlint="markdownlint-cli2 --config ~/.markdownlint.yml"

export BAT_THEME="Catppuccin-mocha"
[[ -f ~/.cache/bat/themes.bin ]] || bat cache --build

# Completion for aws-vault
(( $+commands[aws-vault] )) && eval "$(aws-vault --completion-script-zsh)"

# kubectl krew plugins
path+=(~/.krew/bin(N-/))

# fzf key bindings and completion (https://junegunn.github.io/fzf/)
(( $+commands[fzf] )) && source <(fzf --zsh)

# zoxide - smarter cd command (https://github.com/ajeetdsouza/zoxide)
# Only enable in interactive shells to avoid Claude Code conflicts
if [[ $- == *i* ]] && (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# Starship - cross-shell prompt (https://starship.rs)
(( $+commands[starship] )) && eval "$(starship init zsh)"

# direnv - unclutter your .profile (https://direnv.net)
(( $+commands[direnv] )) && eval "$(direnv hook zsh)"

# mise - polyglot runtime manager (https://github.com/jdx/mise)
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Worktrunk - Git worktree manager (https://worktrunk.dev)
(( $+commands[wt] )) && eval "$(command wt config shell init zsh)"
